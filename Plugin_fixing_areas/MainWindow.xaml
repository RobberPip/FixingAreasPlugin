<Window x:Class="Plugin_fixing_areas.MainWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Plugin_fixing_areas"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d" Height="529" Width="386" Title="Fixing Areas" Icon="pack://application:,,,/FixingAreas;component/aro.ico" >
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Basic/Colors/Light.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
                <hc:ThemeResources  />
                <hc:Theme />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="#FF2D2D30" Margin="0,0,-6,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <ComboBox x:Name="parameterComboBox" Margin="10,22,133,0" DisplayMemberPath="Definition.Name" ItemsSource="{Binding areas}" Height="22" VerticalAlignment="Top" Background="#FFE5E6ED" SelectionChanged="parameterComboBox_SelectionChanged" Grid.ColumnSpan="2"/>
        <ListView x:Name="parameterListView" ItemsSource="{Binding addParameters}" Margin="10,60,15,106" SelectionChanged="selectedListView_SelectionChanged" SelectionMode="Extended" Background="#FF2D2D30" Foreground="#FFEED8D8" Grid.ColumnSpan="2">
            <ListView.Resources>
                <Style TargetType="{x:Type GridViewColumnHeader}">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="#FF2D2D30"/>
                </Style>
            </ListView.Resources>

            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Parameters" Width="{Binding ActualWidth, ElementName=parameterListView}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Definition.Name}" TextAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
        <Button x:Name="add" Content="Добавить" Style="{StaticResource ButtonSuccess}" IsEnabled="False" HorizontalAlignment="Right" Margin="0,22,15,0" VerticalAlignment="Top" Click="Add_Click" Height="28" Width="110" Grid.Column="1"/>
        <Button x:Name="delete" Style="{StaticResource ButtonSuccess}" IsEnabled="False" Content="Удалить" HorizontalAlignment="Right" Margin="0,0,15,78" VerticalAlignment="Bottom" Click="Delete_Click" Height="28" Width="115" Grid.Column="1"/>

        <Button x:Name="save" Content="Зафиксировать значения" Style="{StaticResource ButtonSuccess}" Margin="10,0,7,11" IsEnabled="False" Click="Save_Click" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="28"/>

        <ToggleButton Style="{StaticResource ToggleButtonSwitch}" Name="fileCheckBox" Content="В текущем ФОП" HorizontalAlignment="Left" Margin="13,0,0,44" Foreground="#FFF4F2F2" Height="24" VerticalAlignment="Bottom"/>
        <Button Content="Вернуть значения" Style="{StaticResource ButtonSuccess}" Margin="2,0,15,11" IsEnabled="{Binding returnIsEnable}" Click="Return_Click" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Height="28" Grid.Column="1"/>

    </Grid>

</Window>
